modules = ["web", "nodejs-22"]

[nix]
channel = "stable-25_05"
packages = ["mariadb", "chromium"]

[agent]
expertMode = true

[userenv]

[userenv.shared]
PORT = "3001"
VITE_API_BASE_URL = "/api"
ADMIN_DB_NAME = "gms_admin"
DB_HOST = "localhost"
DB_SOCKET = "/home/runner/workspace/.local/mysql/mysql.sock"
DB_USER = "runner"
BACKUP_DIR = "/home/runner/workspace/.local/mysql/backups"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/dev.sh"
waitForPort = 5000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80
