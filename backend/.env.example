# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3001
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gms_db
DB_USER=gms_user
DB_PASSWORD=your_db_password_here

# Full path to the mysqldump executable.
# On Linux it is usually in PATH — leave blank.
# On Windows, MySQL often isn't in PATH; set the full path:
#   MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
MYSQLDUMP_PATH=

# Database backup storage folder (absolute path)
# If not set, defaults to <app-root>/backups/  (fine for development)
# On a production server, set this to a dedicated backup drive/folder:
#   Windows:  BACKUP_DIR=D:\GMS_Backups
#   Linux:    BACKUP_DIR=/var/backups/gms
BACKUP_DIR=

# JWT Secret (generate a long random string — keep it secret!)
JWT_SECRET=replace_this_with_a_long_random_secret_key_minimum_32_chars
JWT_EXPIRES_IN=8h

# Fallback SMTP — used when no group-specific override matches
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME=GMS Billing
SMTP_FROM_ADDR=your@email.com

# Per-group SMTP overrides (VB6: gv.sDbGroup)
# Pattern: SMTP_{GROUP}_HOST, SMTP_{GROUP}_PORT, SMTP_{GROUP}_SECURE,
#          SMTP_{GROUP}_USER, SMTP_{GROUP}_PASS, SMTP_{GROUP}_FROM_NAME, SMTP_{GROUP}_FROM_ADDR

# MUM group (Gmail)
SMTP_MUM_HOST=smtp.gmail.com
SMTP_MUM_PORT=465
SMTP_MUM_SECURE=true
SMTP_MUM_USER=your_mum_gmail@gmail.com
SMTP_MUM_PASS=your_gmail_app_password
SMTP_MUM_FROM_NAME=GMS Billing
SMTP_MUM_FROM_ADDR=your_mum_gmail@gmail.com

# BHW group (Office 365)
SMTP_BHW_HOST=smtp.office365.com
SMTP_BHW_PORT=587
SMTP_BHW_SECURE=false
SMTP_BHW_USER=accounts@yourdomain.com
SMTP_BHW_PASS=your_o365_app_password
SMTP_BHW_FROM_NAME=Your Company - Accounts
SMTP_BHW_FROM_ADDR=accounts@yourdomain.com
